# Server-only values. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://dmoft:change-me@localhost:5432/dmoft_billing
DATABASE_SSL=false

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_ANNUAL=price_replace_me

# OIDC access-token verification. The subject (sub), never an email address,
# is the application account identity.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=dmoft-billing-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

APP_BASE_URL=http://localhost:3000
LICENSE_ISSUER=https://license.example.com
LICENSE_KEY_ID=dmoft-license-2026-01
# PKCS#8 Ed25519 PEM with newlines escaped as \n. Keep only on the server.
LICENSE_ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
# SubjectPublicKeyInfo Ed25519 PEM; useful to clients and deployment checks.
LICENSE_ED25519_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# During rotation, publish the active key plus retained previous verification keys.
# LICENSE_PUBLIC_KEYSET_JSON={"v":1,"keys":[{"kid":"dmoft-license-2026-01","alg":"EdDSA","public_key":"REPLACE_WITH_RAW_KEY_BASE64URL"}]}
LICENSE_TTL_DAYS=30
LICENSE_REFRESH_AFTER_DAYS=7
OFFLINE_GRACE_DAYS=7
CHALLENGE_TTL_SECONDS=300

# Optional launch-safe JSON override. Unknown Stripe lookup keys never become
# client features. Do not add transport.hybrid until that transport ships.
# ENTITLEMENT_POLICY_JSON={"lookupToEntitlement":{"dmoft_camera_live":"camera.live","dmoft_adaptive_optics":"optics.adaptive"},"deviceLimitByLookup":{"dmoft_devices_3":3},"tierByLookup":{"dmoft_pro":"pro"},"offlineGraceLookupKeys":["dmoft_offline_grace"]}

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=60
WEBHOOK_MAX_BYTES=1048576
