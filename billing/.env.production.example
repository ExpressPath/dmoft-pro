# Inventory only. Replace every placeholder through a protected secret/config
# store; never commit a populated copy.
NODE_ENV=production
DATABASE_URL=postgresql://application-role:REPLACE@database.example.com:5432/dmoft_billing
DATABASE_SSL=true

STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_MONTHLY
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_ANNUAL
STRIPE_WEBHOOK_ENDPOINT_ID=we_REPLACE
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE
STRIPE_LIVE_CANARY_CHARGE_ID=ch_REPLACE_FULLY_REFUNDED

OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=dmoft-billing-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration

APP_BASE_URL=https://billing.example.com
LICENSE_ISSUER=https://licenses.example.com
LICENSE_KEY_ID=dmoft-license-2026-01
LICENSE_ED25519_PRIVATE_KEY_PEM="INJECT_PKCS8_ED25519_PRIVATE_PEM"
LICENSE_ED25519_PUBLIC_KEY_PEM="INJECT_MATCHING_SPKI_ED25519_PUBLIC_PEM"
LICENSE_TTL_DAYS=30
LICENSE_REFRESH_AFTER_DAYS=7
OFFLINE_GRACE_DAYS=7
CHALLENGE_TTL_SECONDS=300

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=60
WEBHOOK_MAX_BYTES=1048576

PRODUCTION_TERMS_URL=https://www.example.com/legal/terms/2026-08-09
PRODUCTION_PRIVACY_URL=https://www.example.com/legal/privacy
PRODUCTION_SUPPORT_URL=https://www.example.com/support
PRODUCTION_TERMS_VERSION=2026-08-09
PRODUCTION_TERMS_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
LEGAL_APPROVAL_REFERENCE=REPLACE_WITH_IMMUTABLE_APPROVAL_RECORD_ID
PRODUCTION_E2E_REFERENCE=REPLACE_WITH_IMMUTABLE_CANARY_RECORD_ID
PRODUCTION_E2E_COMPLETED_AT=2026-08-09T12:00:00.000Z
